[Unit]
Description=qsecret: deliver boot secrets to local containers
After=pve-cluster.service pve-guests.service
Wants=pve-cluster.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/qsecret push
# Parallel share collection plus 15 s per container step; a stuck call must not block forever.
TimeoutStartSec=300
# The identity lives in this process's memory for one run: no core dumps, no swap.
LimitCORE=0
MemorySwapMax=0
# Routine runs log at info and below; keep only notice and up (deliveries, failures).
LogLevelMax=notice
