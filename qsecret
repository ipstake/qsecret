#!/usr/bin/env bash
# qsecret: deliver boot secrets to Proxmox containers when a quorum of nodes agrees.
#
# One age key pair per cluster. The public key (recipient) lives in /etc/pve/priv, so any node
# can encrypt a secret for a container. The private key (identity) is split 3-of-N with Shamir:
# one share per node, encrypted by that node's TPM, plus one offline share for your password manager. The node
# that runs a container collects shares from the other nodes over root SSH, rebuilds the
# identity in memory, decrypts that container's secrets and writes them to the container's /run.
#
#   qsecret init    [--stdout]                  make the key pair, enroll every node (once)
#   qsecret reshare [--stdout] [--identity-stdin]   new shares for the current nodes
#   qsecret rotate  [--stdout]                  new key pair, re-encrypt every secret, reshare
#   qsecret enroll <recipient>                  store this node's share, read from stdin
#   qsecret add [-f] <name> <vmid> <dest> [owner] [mode]   encrypt stdin as a secret
#   qsecret remove <name>                       forget a secret (the CT file stays until reboot)
#   qsecret export [<name>]                     public files (tar.gz), or one secret, to stdout
#   qsecret push                                deliver missing or changed secrets (timer)
#   qsecret check                               prove every node's share works (daily timer)
#   qsecret status                              what is set up, nothing secret
#   qsecret share                               print this node's share (called over SSH)
#   qsecret version                             installed release
#
# The offline backup (init, reshare, rotate) goes to /dev/shm (memory), or with --stdout to
# stdout. Secret output never goes to a terminal: redirect or pipe it, e.g.
#   ssh root@node qsecret export bao-seal > bao-seal.key
# Kill switch: touch /etc/pve/priv/qsecret/disabled.
set -euo pipefail
umask 077
ulimit -c 0

# QSECRET_ROOT and QSECRET_BIN exist for the test suite's fake cluster (tests/). On a real
# node (one with /etc/pve/.members) they are refused, so a leftover export cannot point
# qsecret at a fake tree.
if [[ -n ${QSECRET_ROOT:-}${QSECRET_BIN:-} && -e /etc/pve/.members ]]; then
  echo "<3>qsecret: QSECRET_ROOT/QSECRET_BIN are for tests only; unset them" >&2
  exit 1
fi
R=${QSECRET_ROOT:-}
SHM=${R:+$R/dev/shm}; SHM=${SHM:-/dev/shm}
VERSION_FILE=$R/usr/local/share/qsecret/VERSION
PVE=$R/etc/pve
CL=$PVE/priv/qsecret           # root-only, replicated by pmxcfs
LOCAL=$R/etc/qsecret           # this node only
CRED=$LOCAL/share.cred
CRED_NAME=qsecret-share
RUN=$R/run
STATE=$RUN/qsecret-state       # backoff state, tmpfs
THRESHOLD=3
SELF_BIN=${QSECRET_BIN:-/usr/local/sbin/qsecret}
NAME_RE='^[a-z0-9][a-z0-9_.-]*$'
DEST_RE='^/run(/[A-Za-z0-9_][A-Za-z0-9._-]*)+$'

# Lines that start with <N> get that syslog priority in the journal. The unit keeps only
# notice and above, so routine runs stay out of the log.
log()  { echo "<5>qsecret: $*" >&2; }
warn() { echo "<4>qsecret: $*" >&2; }
die()  { echo "<3>qsecret: $*" >&2; exit 1; }

members() { perl -MJSON -e "my \$m = decode_json(join '', <STDIN>); $1" <"$PVE/.members"; }
SELF=$(members 'print $m->{nodename}')
quorate() { [[ $(members 'print $m->{cluster}{quorate} ? 1 : 0') == 1 ]]; }
online_nodes() { members 'my $n = $m->{nodelist}; for (sort keys %$n) { print "$_ $n->{$_}{ip}\n" if $n->{$_}{online} }'; }
all_nodes()    { members 'my $n = $m->{nodelist}; for (sort keys %$n) { print "$_ $n->{$_}{ip}\n" }'; }

recipient() { cat "$CL/recipient" 2>/dev/null; }

on_node() {  # on_node <name> <ip> <args...>: run qsecret there; stdin passes through
  local name=$1 ip=$2; shift 2
  if [[ $name == "$SELF" ]]; then "$SELF_BIN" "$@"
  else timeout 15 ssh -T -o BatchMode=yes -o ConnectTimeout=5 "root@$ip" "$SELF_BIN" "$@"; fi
}

valid_conf() {  # valid_conf <vmid> <dest> <owner> <mode>
  [[ $1 =~ ^[0-9]+$ && $2 =~ $DEST_RE && $2 != */../* && $2 != */.. && $3 =~ ^[0-9]+:[0-9]+$ && $4 =~ ^0[0-7]{3}$ ]]
}

conf_get() { sed -n "s/^$2=//p" "$1" | head -1; }

write_atomic() {  # write_atomic <path>: stdin to path via a temp file and rename
  cat >"$1.new" && mv -f "$1.new" "$1"
}

# --- offline backup -------------------------------------------------------------------

STDOUT=0
not_a_terminal() { [[ ! -t 1 ]] || die "this writes secrets to stdout; redirect or pipe it"; }

offline_out() {  # stdin is the backup text. A failed write stops the caller before any enroll.
  local text sum f
  text=$(cat)
  sum=$(printf '%s\n' "$text" | sha256sum | cut -c1-16)
  if (( STDOUT )); then
    printf '%s\n' "$text" || die "could not write the backup to stdout; nothing changed"
    # A write into a pipe can succeed while the far end (ssh, a full disk) fails later, so
    # the caller checks their copy against this.
    log "offline backup written to stdout, sha256 starts $sum. Check your copy: sha256sum <file>"
    return
  fi
  mkdir -p "$SHM"
  f=$SHM/qsecret-offline-$(date +%Y%m%d-%H%M%S).txt
  printf '%s\n' "$text" >"$f"
  log "offline backup in $f (memory only, sha256 starts $sum). Copy it to your password manager, then rm it."
}

# --- shares ---------------------------------------------------------------------------

cmd_share() {
  quorate || die "no quorum, not releasing share"
  [[ -s $CRED ]] || die "no share enrolled on $SELF"
  local from=${SSH_CONNECTION:-local}
  log "share released to ${from%% *}"
  local share
  share=$(systemd-creds decrypt --name="$CRED_NAME" "$CRED" -) || die "TPM decrypt failed on $SELF"
  printf '%s %s\n' "$(cat "$LOCAL/share.recipient")" "$share"
}

cmd_enroll() {
  local rcpt=${1:?usage: qsecret enroll <recipient>} share=""
  [[ $rcpt == age1* ]] || die "bad recipient"
  if [[ -t 0 ]]; then read -rsp "share for $SELF: " share || true; echo >&2
  else read -r share || [[ -n $share ]] || die "no share on stdin"; fi
  [[ $share =~ ^[0-9]+-[0-9a-f]+$ ]] || die "that does not look like a share"
  mkdir -p "$LOCAL"
  # host+tpm2: needs this node's TPM and its /var/lib/systemd/credential.secret.
  # Empty PCR list: Proxmox kernel and firmware updates must not lock the share.
  printf '%s' "$share" | systemd-creds encrypt --name="$CRED_NAME" --with-key=host+tpm2 \
    --tpm2-pcrs= - "$CRED.new" 2>/dev/null
  # Prove the new file decrypts to the same share before it replaces the old one.
  [[ $(systemd-creds decrypt --name="$CRED_NAME" "$CRED.new" -) == "$share" ]] ||
    { rm -f "$CRED.new"; die "new share does not decrypt, old share kept"; }
  mv -f "$CRED.new" "$CRED"
  printf '%s\n' "$rcpt" | write_atomic "$LOCAL/share.recipient"
  log "enrolled share on $SELF"
}

# Collect shares for <recipient> from the online nodes, in parallel. One share per line.
collect_shares() {
  local rcpt=$1 tmp name ip f
  tmp=$(mktemp -d -p "$RUN" qsecret.XXXXXX)
  while read -r name ip; do
    # </dev/null: ssh must not eat the node list. Only the line that starts with the
    # recipient counts, so login banners or rc-file noise cannot break the parse.
    ( on_node "$name" "$ip" share </dev/null 2>/dev/null | grep -m1 "^$rcpt " >"$tmp/$name" || true ) &
  done < <(online_nodes)
  wait
  for f in "$tmp"/*; do
    [[ -s $f ]] && cut -d' ' -f2 "$f" || warn "no share for this key from $(basename "$f")"
  done
  rm -rf "$tmp"
}

combine() {  # stdin: shares. ssss-combine prints the secret on stderr.
  ssss-combine -t "$THRESHOLD" -Q 2>&1 >/dev/null | grep -o 'AGE-SECRET-KEY-1[0-9A-Z]*' | head -1
}

# Rebuild the identity for <recipient> from the given shares. A wrong share still combines,
# into garbage, so try each set of 3 and keep the one whose public key matches.
rebuild_from() {
  local rcpt=$1; shift
  local shares=("$@") k=$# a b c id
  (( k >= THRESHOLD )) || { warn "only $k shares, need $THRESHOLD"; return 1; }
  for ((a = 0; a < k; a++)); do for ((b = a + 1; b < k; b++)); do for ((c = b + 1; c < k; c++)); do
    id=$(printf '%s\n' "${shares[a]}" "${shares[b]}" "${shares[c]}" | combine) || true
    [[ -n $id && $(printf '%s\n' "$id" | age-keygen -y 2>/dev/null) == "$rcpt" ]] && { printf '%s\n' "$id"; return 0; }
  done; done; done
  warn "no set of $THRESHOLD shares rebuilds the key"
  return 1
}

rebuild() {
  local shares
  mapfile -t shares < <(collect_shares "$1")
  rebuild_from "$1" "${shares[@]}"
}

# Split <identity> for every cluster node plus one offline share, enroll all nodes, and send
# the offline backup. Every node must be online, so no node keeps a share from an old split.
split_and_enroll() {
  local id=$1 rcpt nodes n shares i=0 name ip line map=""
  rcpt=$(printf '%s\n' "$id" | age-keygen -y)
  mapfile -t nodes < <(all_nodes)
  n=$(( ${#nodes[@]} + 1 ))
  (( $(online_nodes | wc -l) == ${#nodes[@]} )) || die "all ${#nodes[@]} nodes must be online"
  (( ${#nodes[@]} >= THRESHOLD )) || die "need at least $THRESHOLD nodes"
  mapfile -t shares < <(printf '%s\n' "$id" | ssss-split -t "$THRESHOLD" -n "$n" -Q)
  (( ${#shares[@]} == n )) || die "ssss-split made ${#shares[@]} shares, wanted $n"
  # Backup first: if enrolling fails halfway, the identity is already in the offline backup.
  printf 'qsecret offline backup, made on %s %s\nrecipient: %s\noffline share (#%s of %s, threshold %s): %s\nidentity (rebuilds everything alone): %s\n' \
    "$SELF" "$(date -Is)" "$rcpt" "$n" "$n" "$THRESHOLD" "${shares[$((n - 1))]}" "$id" | offline_out
  for line in "${nodes[@]}"; do
    read -r name ip <<<"$line"
    printf '%s\n' "${shares[$i]}" | on_node "$name" "$ip" enroll "$rcpt" ||
      die "enroll failed on $name. Fix it, then: qsecret reshare --identity-stdin (identity from the backup just made)"
    map+="$name ${shares[$i]%%-*}"$'\n'
    i=$(( i + 1 ))
  done
  printf '%s' "$map" | write_atomic "$CL/shares"
}

# After rotate: switch secrets and recipient to the new key.
finish_rotation() {
  local f
  for f in "$CL"/secrets/*.age.rot; do [[ -e $f ]] && mv -f "$f" "${f%.rot}"; done
  mv -f "$CL/recipient.next" "$CL/recipient"
}

cmd_init() {
  quorate || die "no quorum"
  [[ -s $CL/recipient ]] && die "already initialized; use reshare or rotate"
  mkdir -p "$CL/secrets"
  local id; id=$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')
  split_and_enroll "$id"
  printf '%s\n' "$(printf '%s\n' "$id" | age-keygen -y)" | write_atomic "$CL/recipient"
  log "initialized"
}

# New shares for the same key pair: after a node is added, replaced or reinstalled. Old
# shares stop mattering once every node holds a new one and the old offline share is gone.
cmd_reshare() {
  quorate || die "no quorum"
  local rcpt id="" given; rcpt=$(recipient); [[ -n $rcpt ]] || die "not initialized"
  if [[ ${IDENTITY_STDIN:-} == 1 ]]; then
    if [[ -t 0 ]]; then read -rsp "identity: " id || true; echo >&2; else read -r id || true; fi
    [[ -n $id ]] || die "no identity on stdin (the AGE-SECRET-KEY-1... line from the offline backup)"
    given=$(printf '%s\n' "$id" | age-keygen -y 2>/dev/null) || die "not an age identity"
    # A rotation that stopped halfway: finish it with the new identity.
    if [[ -s $CL/recipient.next && $given == "$(cat "$CL/recipient.next")" ]]; then
      split_and_enroll "$id"; finish_rotation; log "finished the interrupted rotation"; return
    fi
    [[ $given == "$rcpt" ]] || die "identity does not match the recipient"
  else
    id=$(rebuild "$rcpt") || die "could not rebuild the key from the nodes; use --identity-stdin with the identity from the offline backup"
  fi
  split_and_enroll "$id"
  log "reshared"
}

# New key pair: after a disk or node is lost or stolen. Re-encrypts every secret.
cmd_rotate() {
  quorate || die "no quorum"
  local old_rcpt old_id new_id new_rcpt f
  old_rcpt=$(recipient); [[ -n $old_rcpt ]] || die "not initialized"
  old_id=$(rebuild "$old_rcpt") || die "could not rebuild the current key"
  new_id=$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')
  new_rcpt=$(printf '%s\n' "$new_id" | age-keygen -y)
  for f in "$CL"/secrets/*.age; do
    [[ -e $f ]] || continue
    age -d -i <(printf '%s\n' "$old_id") "$f" | age -r "$new_rcpt" -o "$f.rot"
  done
  printf '%s\n' "$new_rcpt" | write_atomic "$CL/recipient.next"
  split_and_enroll "$new_id"
  # Switch only after every node holds a share of the new key.
  finish_rotation
  log "rotated to $new_rcpt; delete the old offline backup from your password manager"
}

# --- secrets --------------------------------------------------------------------------

cmd_add() {
  local force=0; [[ ${1:-} == -f ]] && { force=1; shift; }
  local name=${1:?usage: qsecret add [-f] <name> <vmid> <dest> [owner] [mode]} vmid=${2:?vmid} dest=${3:?dest}
  local owner=${4:-0:0} mode=${5:-0400} rcpt tmp
  [[ $name =~ $NAME_RE ]] || die "bad name"
  valid_conf "$vmid" "$dest" "$owner" "$mode" || die "bad vmid, dest (/run/..., no ..), owner (uid:gid) or mode (0NNN)"
  rcpt=$(recipient); [[ -n $rcpt ]] || die "not initialized"
  [[ -t 0 ]] && die "pipe the secret on stdin"
  (( force )) || [[ ! -e $CL/secrets/$name.age ]] || die "$name exists; use -f to replace it"
  # Check for empty input before encrypting: an empty secret could never be delivered.
  mkdir -p "$SHM"; tmp=$(mktemp -p "$SHM"); cat >"$tmp"
  [[ -s $tmp ]] || { rm -f "$tmp"; die "empty secret"; }
  age -r "$rcpt" -o "$CL/secrets/$name.age.new" "$tmp"; rm -f "$tmp"
  mv -f "$CL/secrets/$name.age.new" "$CL/secrets/$name.age"
  printf 'vmid=%s\ndest=%s\nowner=%s\nmode=%s\n' "$vmid" "$dest" "$owner" "$mode" | write_atomic "$CL/secrets/$name.conf"
  log "added $name for CT $vmid at $dest"
}

cmd_remove() {
  local name=${1:?usage: qsecret remove <name>}
  [[ $name =~ $NAME_RE && -e $CL/secrets/$name.conf ]] || die "no secret $name"
  rm -f "$CL/secrets/$name.conf" "$CL/secrets/$name.age"
  log "removed $name"
}

cmd_export() {
  local name=${1:-} id
  not_a_terminal
  if [[ -z $name ]]; then
    # Public files only: recipient, share map, ciphertexts, configs. Useless without the identity.
    tar -C "$CL" -cz --exclude=disabled .
    log "exported public files"
  else
    [[ $name =~ $NAME_RE && -e $CL/secrets/$name.age ]] || die "no secret $name"
    quorate || die "no quorum"
    id=$(rebuild "$(recipient)") || die "could not rebuild the key"
    age -d -i <(printf '%s\n' "$id") "$CL/secrets/$name.age"
    log "exported $name"
  fi
}

# --- delivery -------------------------------------------------------------------------

ct() {  # ct <vmid> <args...>: run in the container, host env not passed
  local vmid=$1; shift
  timeout 15 pct exec "$vmid" --keep-env 0 -- "$@"
}

# Runs inside the container. Writes stdin to $1 only if /run is a tmpfs, the path has no
# symlinks, and the input is not empty. $4 is the version, stored next to the secret.
CT_WRITE='set -eu
  d=$(dirname "$1")
  [ "$(stat -f -c %T /run)" = tmpfs ] || { echo "/run is not tmpfs yet" >&2; exit 3; }
  # No symlink anywhere in the path, checked before anything is created or changed, so
  # mkdir and chmod never follow a link.
  p=""; old=$IFS; IFS=/
  for c in ${1#/}; do
    p="$p/$c"
    [ ! -L "$p" ] || { echo "$p is a symlink: $1 has a symlink in its path" >&2; exit 4; }
  done
  IFS=$old
  case "$d" in /run) ;; *) mkdir -p "$d"; chmod 0755 "$d" ;; esac
  t=$(mktemp "$d/.qsecret.XXXXXX"); trap "rm -f \"$t\"" EXIT
  cat >"$t"
  [ -s "$t" ] || { echo "empty input" >&2; exit 5; }
  chown -- "$2" "$t"; chmod -- "$3" "$t"; mv -f -- "$t" "$1"; trap - EXIT
  printf "%s\n" "$4" >"$1.version"'

# Version of a secret: hash of its ciphertext. A changed secret gets delivered again.
version() { sha256sum "$CL/secrets/$1.age" | cut -c1-16; }

needs_delivery() {  # needs_delivery <vmid> <dest> <version>
  [[ $(ct "$1" sh -c '[ -s "$1" ] && cat "$1.version" 2>/dev/null' qsecret "$2" </dev/null || true) != "$3" ]]
}

backoff_ok() {  # skip a secret that failed recently: 20 s, 40 s, ... up to 10 min
  local f=$STATE/$1 n t
  [[ -e $f ]] || return 0
  read -r n t <"$f"
  (( $(date +%s) >= t ))
}
backoff_fail() {
  local f=$STATE/$1 n=0 t
  [[ -e $f ]] && read -r n t <"$f"
  n=$(( n + 1 )); t=$(( 20 << (n < 5 ? n : 5) )); (( t > 600 )) && t=600
  echo "$n $(( $(date +%s) + t ))" >"$f"
}
backoff_clear() { rm -f "$STATE/$1"; }

cmd_push() {
  [[ -e $CL/disabled ]] && exit 0
  quorate || exit 0
  local rcpt; rcpt=$(recipient); [[ -n $rcpt ]] || exit 0
  mkdir -p "$STATE"
  exec 9>"$STATE/lock"; flock -n 9 || exit 0

  local todo=() conf name vmid dest owner mode ver
  for conf in "$CL"/secrets/*.conf; do
    [[ -e $conf ]] || continue
    name=$(basename "$conf" .conf)
    vmid=$(conf_get "$conf" vmid); dest=$(conf_get "$conf" dest)
    owner=$(conf_get "$conf" owner); mode=$(conf_get "$conf" mode)
    if ! valid_conf "$vmid" "$dest" "$owner" "$mode"; then warn "$name has a bad config, skipped"; continue; fi
    [[ -e $PVE/nodes/$SELF/lxc/$vmid.conf ]] || continue
    [[ $(pct status "$vmid" 2>/dev/null) == "status: running" ]] || continue
    ver=$(version "$name")
    needs_delivery "$vmid" "$dest" "$ver" || { backoff_clear "$name"; continue; }
    backoff_ok "$name" || continue
    todo+=("$name")
  done
  (( ${#todo[@]} )) || exit 0

  # Fewer than THRESHOLD nodes online is "not ready", not an error.
  (( $(online_nodes | wc -l) >= THRESHOLD )) || { log "waiting for $THRESHOLD nodes"; exit 0; }

  local id failed=0
  if ! id=$(rebuild "$rcpt"); then
    for name in "${todo[@]}"; do backoff_fail "$name"; done
    die "could not rebuild the key; ${#todo[@]} secret(s) waiting"
  fi
  for name in "${todo[@]}"; do
    conf=$CL/secrets/$name.conf
    vmid=$(conf_get "$conf" vmid); dest=$(conf_get "$conf" dest)
    owner=$(conf_get "$conf" owner); mode=$(conf_get "$conf" mode); ver=$(version "$name")
    # Identity and secret go through pipes only: never argv, env or the node's disk.
    if age -d -i <(printf '%s\n' "$id") "$CL/secrets/$name.age" |
      ct "$vmid" sh -c "$CT_WRITE" qsecret "$dest" "$owner" "$mode" "$ver"; then
      backoff_clear "$name"; log "delivered $name to CT $vmid"
    else
      backoff_fail "$name"; warn "failed to deliver $name to CT $vmid"; failed=1
    fi
  done
  id=
  exit $failed
}

# Prove that every node's share is part of a working set, so a bad share shows up now and
# not during an outage.
cmd_check() {
  quorate || die "no quorum"
  local rcpt; rcpt=$(recipient); [[ -n $rcpt ]] || die "not initialized"
  local tmp name ip f ok=0 bad=0 others s
  tmp=$(mktemp -d -p "$RUN" qsecret.XXXXXX)
  while read -r name ip; do
    ( on_node "$name" "$ip" share </dev/null 2>/dev/null | grep -m1 "^$rcpt " | cut -d' ' -f2 >"$tmp/$name" || true ) &
  done < <(all_nodes)
  wait
  for f in "$tmp"/*; do
    name=$(basename "$f")
    if [[ ! -s $f ]]; then echo "$name: no share for the current key"; bad=$(( bad + 1 )); continue; fi
    mapfile -t others < <(cat "$tmp"/* | grep -vxF "$(cat "$f")" | grep .)
    s=$(cat "$f")
    # This share plus any 2 others must rebuild the key.
    local a b found=0
    for ((a = 0; a < ${#others[@]} && !found; a++)); do for ((b = a + 1; b < ${#others[@]} && !found; b++)); do
      [[ $(printf '%s\n' "$s" "${others[a]}" "${others[b]}" | combine | age-keygen -y 2>/dev/null) == "$rcpt" ]] && found=1
    done; done
    if (( found )); then echo "$name: ok"; ok=$(( ok + 1 )); else echo "$name: share does not work"; bad=$(( bad + 1 )); fi
  done
  rm -rf "$tmp"
  echo "$ok ok, $bad bad, threshold $THRESHOLD"
  (( bad == 0 && ok >= THRESHOLD ))
}

cmd_status() {
  echo "node:       $SELF"
  echo "quorate:    $(quorate && echo yes || echo no)"
  echo "recipient:  $(recipient || true)"
  if [[ -s $CRED ]]; then
    echo "share:      enrolled for $(cat "$LOCAL/share.recipient"), $(systemd-creds decrypt --name="$CRED_NAME" "$CRED" - >/dev/null 2>&1 && echo decrypts || echo "DOES NOT DECRYPT")"
  else
    echo "share:      none"
  fi
  echo "shares:     $([[ -s $CL/shares ]] && tr '\n' ' ' <"$CL/shares" || echo "no map yet (run reshare)")"
  echo "disabled:   $([[ -e $CL/disabled ]] && echo yes || echo no)"
  local conf name vmid dest where
  for conf in "$CL"/secrets/*.conf; do
    [[ -e $conf ]] || continue
    name=$(basename "$conf" .conf); vmid=$(conf_get "$conf" vmid); dest=$(conf_get "$conf" dest)
    where=$(basename "$(dirname "$(dirname "$(ls "$PVE"/nodes/*/lxc/"$vmid".conf 2>/dev/null | head -1)")")" 2>/dev/null || true)
    echo "secret:     $name -> CT $vmid:$dest (on ${where:-?}, version $(version "$name"))"
  done
}

# --- main -----------------------------------------------------------------------------

c=${1:-}; shift || true
args=()
while (( $# )); do
  case $1 in
    --stdout) STDOUT=1; not_a_terminal; shift ;;
    --identity-stdin) IDENTITY_STDIN=1; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
case $c in
  init | reshare | rotate | enroll | add | remove | export | push | check | status | share) "cmd_$c" "${args[@]}" ;;
  version | --version) cat "$VERSION_FILE" 2>/dev/null || echo unknown ;;
  *) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
